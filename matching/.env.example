# Copy this file to .env and fill in your real values before running.

# OpenAI-compatible API credentials
OPENAI_API_KEY=your_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Optional provider-specific aliases used by this script.
# When SOULAGENT_PROVIDER=siliconflow, the script defaults to
# https://api.siliconflow.cn/v1 unless OPENAI_API_BASE is set.
SOULAGENT_PROVIDER=siliconflow
SOULAGENT_API_KEY=your_siliconflow_api_key_here
SOULAGENT_API_BASE=https://api.siliconflow.cn/v1
SOULAGENT_MODEL=Qwen/Qwen2.5-7B-Instruct

# llm or heuristic
MATCH_EXPLANATION_MODE=llm
