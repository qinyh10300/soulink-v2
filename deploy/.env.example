# Required production values. Never commit deploy/.env.
POSTGRES_PASSWORD=
# Format: postgres://solink:<password>@postgres:5432/soulink-web?sslmode=disable
DB_DSN=
JWT_SECRET=

# Public application settings
APP_ENV=production
ALLOWED_ORIGINS=https://example.com
DB_AUTO_MIGRATE=true

# Redis
REDIS_ENABLED=true
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=soulink:

# Authentication
JWT_TTL=72h
VERIFICATION_CODE_TTL=5m
VERIFICATION_CODE_COOLDOWN=60s
BCRYPT_COST=12

# Email
MAIL_DRIVER=log
MAIL_FROM_NAME=SouLink
MAIL_FROM_ADDRESS=noreply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ACCOUNTS_FILE=

# Optional AI enhancement. Deterministic intent and recommendation fallback is always available.
AI_PROVIDER=disabled
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=8s
AI_MAX_RETRIES=2

# Optional LLM-powered SoulAgent
SOULAGENT_PROVIDER=
SOULAGENT_API_KEY=
SOULAGENT_API_KEYS=
SOULAGENT_API_BASE=
SOULAGENT_MODEL=
SOULAGENT_MODEL_POOL=
