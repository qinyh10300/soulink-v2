# Application
APP_ENV=development
HTTP_ADDR=:8080
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL
DB_DSN=postgres://solink:soulink@127.0.0.1:15432/soulink-web?sslmode=disable
DB_AUTO_MIGRATE=true

# Redis
REDIS_ENABLED=false
REDIS_ADDR=127.0.0.1:16379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=soulink:

# Authentication
# Generate a long random value before using this outside local development.
JWT_SECRET=
JWT_TTL=72h
VERIFICATION_CODE_TTL=5m
VERIFICATION_CODE_COOLDOWN=60s
BCRYPT_COST=12

# Email
MAIL_DRIVER=log
MAIL_FROM_NAME=SouLink
MAIL_FROM_ADDRESS=noreply@soulink.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ACCOUNTS_FILE=
SMTP_MAX_ATTEMPTS=3

# Questionnaire and matching
QUESTIONNAIRE_CATALOG_FILE=thu_questionnaire_template.md
MATCH_RESULT_CACHE_TTL=24h

# Optional LLM-powered SoulAgent
SOULAGENT_ENABLED=false
SOULAGENT_PROVIDER=
SOULAGENT_API_KEY=
SOULAGENT_API_KEYS=
SOULAGENT_API_BASE=
SOULAGENT_MODEL=
SOULAGENT_MODEL_POOL=
SOULAGENT_ROOT=
SOULAGENT_PYTHON=python3
